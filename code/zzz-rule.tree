form natural
  case zero
  case succ
    link prior, like natural

task plus
  take a, like natural
  take b, like natural
  like natural
  fork case, read a
    case zero
      send back
        read b
    case succ
      send back
        make succ
          bind prior
            call plus
              read prior
              read b

rule one-plus-one-is-two
  show hold
    call is-equal
      call plus
        make succ
          bind prior
            make zero
        make succ
          bind prior
            make zero
      make succ
        bind prior
          make succ
            bind prior
              make zero
  calm
