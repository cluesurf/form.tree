# The Pauli group on one qubit, modeled as a REAL COMPUTABLE group. The single-qubit gates are I, X, Y, Z with a phase
# that is a power of i. You multiply any two and the kernel proves the relations: each Pauli squares to the identity, X
# times Y is i times Z, and X and Y ANTICOMMUTE. These are the generators of the single-qubit Clifford group and the errors
# a quantum code corrects. The sixteen-entry product table (with its Z/4 phase) is generated by a single `tree` TEMPLATE,
# one fused line per entry, so it reads off the table instead of a repeated block.

# A phase, a power of i: 1, i, -1, -i.
form phase
  case one
  case eye
  case neg
  case neg-eye

task mul-phase
  take a, like phase
  take b, like phase
  like phase
  fork case, read a
    case one
      send back
        read b
    case eye
      fork case, read b
        case one
          send back
            make eye
        case eye
          send back
            make neg
        case neg
          send back
            make neg-eye
        case neg-eye
          send back
            make one
    case neg
      fork case, read b
        case one
          send back
            make neg
        case eye
          send back
            make neg-eye
        case neg
          send back
            make one
        case neg-eye
          send back
            make eye
    case neg-eye
      fork case, read b
        case one
          send back
            make neg-eye
        case eye
          send back
            make one
        case neg
          send back
            make eye
        case neg-eye
          send back
            make neg

form pauli
  case letter-i
  case letter-x
  case letter-y
  case letter-z

form op
  case scaled
    link phase, like phase
    link pauli, like pauli

# TEMPLATE: one entry of the Pauli letter-product table, the phase and resulting letter for a column.
tree letter-entry
  take col
  take ph
  take res

  hook fuse
    case {col}
      send back
        make scaled
          bind phase
            make {ph}
          bind pauli
            make {res}

# THE PAULI PRODUCT TABLE, X Y = i Z and the rest, one fused line per entry.
task mul-letter
  take a, like pauli
  take b, like pauli
  like op
  fork case, read a
    case letter-i
      fork case, read b
        fuse letter-entry, letter-i, one, letter-i
        fuse letter-entry, letter-x, one, letter-x
        fuse letter-entry, letter-y, one, letter-y
        fuse letter-entry, letter-z, one, letter-z
    case letter-x
      fork case, read b
        fuse letter-entry, letter-i, one, letter-x
        fuse letter-entry, letter-x, one, letter-i
        fuse letter-entry, letter-y, eye, letter-z
        fuse letter-entry, letter-z, neg-eye, letter-y
    case letter-y
      fork case, read b
        fuse letter-entry, letter-i, one, letter-y
        fuse letter-entry, letter-x, neg-eye, letter-z
        fuse letter-entry, letter-y, one, letter-i
        fuse letter-entry, letter-z, eye, letter-x
    case letter-z
      fork case, read b
        fuse letter-entry, letter-i, one, letter-z
        fuse letter-entry, letter-x, eye, letter-y
        fuse letter-entry, letter-y, neg-eye, letter-x
        fuse letter-entry, letter-z, one, letter-i

task combine-phase
  take pa, like phase
  take pb, like phase
  take prod, like op
  like op
  fork case, read prod
    case scaled
      link pp
      link letter
      send back
        make scaled
          bind phase
            call mul-phase
              call mul-phase
                read pa
                read pb
              read pp
          bind pauli
            read letter

# THE FULL PAULI PRODUCT.
task mul
  take x, like op
  take y, like op
  like op
  fork case, read x
    case scaled
      link px
      link lx
      fork case, read y
        case scaled
          link py
          link ly
          send back
            call combine-phase
              read px
              read py
              call mul-letter
                read lx
                read ly

# TEMPLATE: a Pauli product fact, mul (one a) (one b) = (phase) c.
tree fact
  take name
  take a
  take b
  take ph
  take c

  hook fuse
    rule {name}
      show hold
        call is-equal
          call mul
            make scaled
              bind phase
                make one
              bind pauli
                make {a}
            make scaled
              bind phase
                make one
              bind pauli
                make {b}
          make scaled
            bind phase
              make {ph}
            bind pauli
              make {c}
      calm hold

# The Pauli relations, one line each: X^2 = I, X Y = i Z, Y X = -i Z (so X and Y anticommute, opposite phases).
fuse fact, x-squares-to-identity, letter-x, letter-x, one, letter-i
fuse fact, x-times-y-is-i-z, letter-x, letter-y, eye, letter-z
fuse fact, y-times-x-is-neg-i-z, letter-y, letter-x, neg-eye, letter-z