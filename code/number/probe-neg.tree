load @/code/number/integer
  find rung
  find natural

# local negate, to test whether the FORM import (rung/natural) resolves even if task import does not.
task flip
  take z, like rung
  like rung
  fork case, read z
    case negsucc
      link p
      send back
        make possucc
          bind prior
            read p
    case zero-int
      send back
        make zero-int
    case possucc
      link p
      send back
        make negsucc
          bind prior
            read p

rule probe-flip-zero
  show hold
    call is-equal
      call flip
        make zero-int
      make zero-int
  calm
