load @/code/number/integer
  find integer

load @/code/algebra/cayley-dickson
  find cayley-dickson-double

load @/code/algebra/normed-division
  find normed-division-algebra

# The complex numbers, the Cayley-Dickson double of the reals, dimension two.
# They are a normed division algebra, commutative and associative, but they
# lose the order: they carry a square root of minus one, whose square is below
# zero, so no order can place them. This is the first rung past the integers,
# and the first loss in the tower, the loss of order.
structure complex
  head type
  link source, like cayley-dickson-double, have type
  link algebra, like normed-division-algebra, have type
  assert dimension-two
    head type, have type
    have algebra
  # The complex numbers are not orderable: they carry a square root of minus
  # one. This is the loss of order, the first step of the tower.
  assert not-orderable
    head type, have type
    have algebra
