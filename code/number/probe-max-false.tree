form natural
  case zero
  case succ
    link prior, like natural

task max
  take a, like natural
  take b, like natural
  like natural
  fork case, read a
    case zero
      send back
        read b
    case succ
      link ap
      fork case, read b
        case zero
          send back
            make succ
              bind prior
                read ap
        case succ
          link bp
          send back
            make succ
              bind prior
                call max
                  read ap
                  read bp

rule max-idempotent-FALSE
  mark a, like natural
  show hold
    call is-equal
      call max
        read a
        read a
      make succ
        bind prior
          read a
  fold a
    cite max-idempotent-FALSE
