load @/code/structure/space/vector
  find vector-space

# A root system is a finite set of vectors, the roots, closed under the
# reflections in the hyperplanes perpendicular to them, with each root's
# reflection of another root differing from it by an integer multiple of the
# root. Root systems classify the simple Lie algebras and the regular
# symmetric structures. The one that carries Vibe Theory is the root system of
# the rotation algebra of eight-dimensional space, whose rank is four and whose
# roots are the twenty-four vertices of the 24-cell.
structure root-system
  head type
  link space, like vector-space, have type
  link roots, like set, have type
  # The roots span the space, and its dimension is the rank.
  assert spans-space
    head type, have type
    have space
    have roots
  # The set of roots is closed under reflection in each root's hyperplane.
  assert reflection-closure
    head type, have type
    have space
    have roots
  # Each reflected root differs by an integer multiple, the crystallographic
  # condition that makes the system a lattice symmetry.
  assert integrality
    head type, have type
    have space
    have roots
