# The Clifford algebra Cl(0,2), isomorphic to the quaternions, modeled as a REAL COMPUTABLE algebra. Two generators e1,
# e2 each square to MINUS ONE and ANTICOMMUTE; the four basis blades are the scalar one, the vectors e1 and e2, and the
# bivector e12 = e1 e2. You multiply any two blades and the kernel proves the defining relations (e1 e1 = -one, e1 e2 =
# e12, e2 e1 = -e12, e12 e12 = -one). The sixteen-entry blade product is generated by a single `tree` TEMPLATE, one fused
# line per entry. Cl(0,2) is the smallest Clifford algebra carrying a spinor (i, j, k are e1, e2, e12), the spin-one-half
# structure, the same shape the octonion's seven generators carry at Cl(0,7) for one generation of matter.

form sign
  case pos
  case neg

form blade
  case one
  case e1
  case e2
  case e12

form cliff
  case scaled
    link sign, like sign
    link blade, like blade

task mul-sign
  take a, like sign
  take b, like sign
  like sign
  fork case, read a
    case pos
      send back
        read b
    case neg
      fork case, read b
        case pos
          send back
            make neg
        case neg
          send back
            make pos

# TEMPLATE: one entry of the blade product table.
tree blade-entry
  take col
  take s
  take res

  hook fuse
    case {col}
      send back
        make scaled
          bind sign
            make {s}
          bind blade
            make {res}

# THE BLADE PRODUCT TABLE, e1 e2 = e12 and the rest, one fused line per entry.
task mul-blade
  take a, like blade
  take b, like blade
  like cliff
  fork case, read a
    case one
      fork case, read b
        fuse blade-entry, one, pos, one
        fuse blade-entry, e1, pos, e1
        fuse blade-entry, e2, pos, e2
        fuse blade-entry, e12, pos, e12
    case e1
      fork case, read b
        fuse blade-entry, one, pos, e1
        fuse blade-entry, e1, neg, one
        fuse blade-entry, e2, pos, e12
        fuse blade-entry, e12, neg, e2
    case e2
      fork case, read b
        fuse blade-entry, one, pos, e2
        fuse blade-entry, e1, neg, e12
        fuse blade-entry, e2, neg, one
        fuse blade-entry, e12, pos, e1
    case e12
      fork case, read b
        fuse blade-entry, one, pos, e12
        fuse blade-entry, e1, pos, e2
        fuse blade-entry, e2, neg, e1
        fuse blade-entry, e12, neg, one

task apply-signs
  take sx, like sign
  take sy, like sign
  take prod, like cliff
  like cliff
  fork case, read prod
    case scaled
      link sp
      link bp
      send back
        make scaled
          bind sign
            call mul-sign
              call mul-sign
                read sx
                read sy
              read sp
          bind blade
            read bp

# THE FULL PRODUCT of two Clifford elements.
task mul
  take x, like cliff
  take y, like cliff
  like cliff
  fork case, read x
    case scaled
      link sx
      link bx
      fork case, read y
        case scaled
          link sy
          link by
          send back
            call apply-signs
              read sx
              read sy
              call mul-blade
                read bx
                read by

# TEMPLATE: a single Clifford relation, mul (pos a) (pos b) = (sign) c.
tree relation
  take name
  take a
  take b
  take rs
  take rc

  hook fuse
    rule {name}
      show hold
        call is-equal
          call mul
            make scaled
              bind sign
                make pos
              bind blade
                make {a}
            make scaled
              bind sign
                make pos
              bind blade
                make {b}
          make scaled
            bind sign
              make {rs}
            bind blade
              make {rc}
      calm hold

# The defining Clifford relations, one line each: e1 and e2 square to -1, they anticommute (e1 e2 = e12, e2 e1 = -e12),
# and the bivector squares to -1.
fuse relation, e1-squared-is-minus-one, e1, e1, neg, one
fuse relation, e2-squared-is-minus-one, e2, e2, neg, one
fuse relation, e1-times-e2-is-the-bivector, e1, e2, pos, e12
fuse relation, e2-times-e1-is-minus-the-bivector, e2, e1, neg, e12
fuse relation, bivector-squares-to-minus-one, e12, e12, neg, one