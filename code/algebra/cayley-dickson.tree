load @/code/structure/function/binary
  find binary-function

load @/code/structure/function/unary
  find unary-function

# The Cayley-Dickson construction doubles a star-algebra. Given an algebra with
# a conjugation, the double is the set of ordered pairs of its elements, with a
# product that mixes the two parts through the conjugation, and a conjugation
# that flips the sign of the second part. The double has twice the dimension of
# the input. Applied from the one-dimensional start it builds the tower of the
# reals, complexes, quaternions, octonions, and sedenions, of dimensions one,
# two, four, eight, sixteen. Each step trades away one property in a fixed
# order: the order, then commutativity, then associativity, then the norm
# itself. The double keeps the norm exactly when the input is associative,
# which is the Hurwitz condition. So the norm survives through the octonions,
# whose input is the associative quaternions, and dies at the sedenions, whose
# input the octonions are not associative. That is why the reversible ceiling
# is eight.
structure cayley-dickson-double
  head type
  # The input algebra being doubled, carrying a conjugation.
  link base, like type
  link base-conjugation, like unary-function, have type
  # The doubled product and conjugation, on pairs of base elements.
  link multiplication, like binary-function, have type
  link conjugation, like unary-function, have type
  # The double has twice the dimension of the input.
  assert dimension-doubling
    head type, have type
    have base
    have multiplication
  # The double is a composition algebra exactly when the input is associative.
  # This Hurwitz condition is the hinge of the whole tower.
  assert norm-preserved-iff-associative
    head type, have type
    have base
    have multiplication
