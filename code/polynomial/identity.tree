# The elementary polynomial identities, each a universal law over the integers, proved by the commutative-ring
# normalizer and checked by `seed test`. Every identity below holds for ALL values of its variables (the parameters
# are universally quantified): the prover normalizes both sides to the same canonical polynomial, which is identically
# equal over any commutative ring. These are the algebraic backbone the number tower and the norm identities rest on.

# The square of a sum: (a + b)^2 = a^2 + 2 a b + b^2.
rule square-of-sum-expands
  mark a, like integer
  mark b, like integer
  show hold
    call is-equal
      call multiply
        call add
          read a
          read b
        call add
          read a
          read b
      call add
        call add
          call multiply
            read a
            read a
          call multiply
            code 2
            call multiply
              read a
              read b
        call multiply
          read b
          read b

# The square of a difference: (a - b)^2 = a^2 - 2 a b + b^2.
rule square-of-difference-expands
  mark a, like integer
  mark b, like integer
  show hold
    call is-equal
      call multiply
        call subtract
          read a
          read b
        call subtract
          read a
          read b
      call add
        call subtract
          call multiply
            read a
            read a
          call multiply
            code 2
            call multiply
              read a
              read b
        call multiply
          read b
          read b

# The difference of squares: (a - b)(a + b) = a^2 - b^2.
rule difference-of-squares-factors
  mark a, like integer
  mark b, like integer
  show hold
    call is-equal
      call multiply
        call subtract
          read a
          read b
        call add
          read a
          read b
      call subtract
        call multiply
          read a
          read a
        call multiply
          read b
          read b

# The cube of a sum: (a + b)^3 = a^3 + 3 a^2 b + 3 a b^2 + b^3.
rule cube-of-sum-expands
  mark a, like integer
  mark b, like integer
  show hold
    call is-equal
      call multiply
        call multiply
          call add
            read a
            read b
          call add
            read a
            read b
        call add
          read a
          read b
      call add
        call add
          call add
            call multiply
              call multiply
                read a
                read a
              read a
            call multiply
              code 3
              call multiply
                call multiply
                  read a
                  read a
                read b
          call multiply
            code 3
            call multiply
              read a
              call multiply
                read b
                read b
        call multiply
          call multiply
            read b
            read b
          read b

# The sum of two cubes: a^3 + b^3 = (a + b)(a^2 - a b + b^2).
rule sum-of-cubes-factors
  mark a, like integer
  mark b, like integer
  show hold
    call is-equal
      call add
        call multiply
          call multiply
            read a
            read a
          read a
        call multiply
          call multiply
            read b
            read b
          read b
      call multiply
        call add
          read a
          read b
        call add
          call subtract
            call multiply
              read a
              read a
            call multiply
              read a
              read b
          call multiply
            read b
            read b

# The difference of two cubes: a^3 - b^3 = (a - b)(a^2 + a b + b^2).
rule difference-of-cubes-factors
  mark a, like integer
  mark b, like integer
  show hold
    call is-equal
      call subtract
        call multiply
          call multiply
            read a
            read a
          read a
        call multiply
          call multiply
            read b
            read b
          read b
      call multiply
        call subtract
          read a
          read b
        call add
          call add
            call multiply
              read a
              read a
            call multiply
              read a
              read b
          call multiply
            read b
            read b

# The Sophie Germain identity: a^4 + 4 b^4 = (a^2 + 2 a b + 2 b^2)(a^2 - 2 a b + 2 b^2). The factorization of a sum of a
# fourth power and four times a fourth power, the classic example that a^4 + 4 is composite for every a above one.
rule sophie-germain-identity-factors-fourth-power-sum
  mark a, like integer
  mark b, like integer
  show hold
    call is-equal
      call add
        call multiply
          call multiply
            call multiply
              read a
              read a
            read a
          read a
        call multiply
          code 4
          call multiply
            call multiply
              call multiply
                read b
                read b
              read b
            read b
      call multiply
        call add
          call add
            call multiply
              read a
              read a
            call multiply
              code 2
              call multiply
                read a
                read b
          call multiply
            code 2
            call multiply
              read b
              read b
        call add
          call subtract
            call multiply
              read a
              read a
            call multiply
              code 2
              call multiply
                read a
                read b
          call multiply
            code 2
            call multiply
              read b
              read b

# The square of a three-term sum: (a + b + c)^2 = a^2 + b^2 + c^2 + 2 a b + 2 b c + 2 c a.
rule square-of-three-term-sum-expands
  mark a, like integer
  mark b, like integer
  mark c, like integer
  show hold
    call is-equal
      call multiply
        call add
          call add
            read a
            read b
          read c
        call add
          call add
            read a
            read b
          read c
      call add
        call add
          call add
            call add
              call add
                call multiply
                  read a
                  read a
                call multiply
                  read b
                  read b
              call multiply
                read c
                read c
            call multiply
              code 2
              call multiply
                read a
                read b
          call multiply
            code 2
            call multiply
              read b
              read c
        call multiply
          code 2
          call multiply
            read c
            read a

# Euler's factorization: a^3 + b^3 + c^3 - 3 a b c = (a + b + c)(a^2 + b^2 + c^2 - a b - b c - c a), for every a, b, c.
# The identity behind the fact that a sum of three cubes minus thrice their product factors through the cyclic sum.
rule three-cube-sum-minus-thrice-product-factors
  mark a, like integer
  mark b, like integer
  mark c, like integer
  show hold
    call is-equal
      call subtract
        call add
          call add
            call multiply
              call multiply
                read a
                read a
              read a
            call multiply
              call multiply
                read b
                read b
              read b
          call multiply
            call multiply
              read c
              read c
            read c
        call multiply
          code 3
          call multiply
            call multiply
              read a
              read b
            read c
      call multiply
        call add
          call add
            read a
            read b
          read c
        call subtract
          call subtract
            call subtract
              call add
                call add
                  call multiply
                    read a
                    read a
                  call multiply
                    read b
                    read b
                call multiply
                  read c
                  read c
              call multiply
                read a
                read b
            call multiply
              read b
              read c
          call multiply
            read c
            read a
