# The 24-cell, the unique self-dual regular polytope in four dimensions: twenty-four vertices, ninety-six edges, ninety-
# six faces, twenty-four octahedral cells. Its vertices are the D4 roots, the 4-vectors with exactly two nonzero slots,
# each plus or minus one. This file MODELS that vertex set concretely and proves its structure: the count 24 = 6 * 4
# (choose two of four axes, six ways, a sign for each, four ways), the f-vector's vanishing Euler characteristic, and the
# ANTIPODE map (negate both signs) which is an involution with no fixed point, so the twenty-four vertices pair into the
# twelve lines the law acts on. These are the twenty-four directions a tone may step. Four independent constructions
# (D4 roots, the two-nonzero ternary shell, the unit Hurwitz quaternions, the 4D kissing configuration) meet on these
# same points, which is how the figure is known to be forced.

# A sign on a nonzero coordinate.
form sign
  case neg
  case pos

# Which two of the four axes (w, x, y, z) are nonzero: the six unordered pairs.
form duo
  case wx
  case wy
  case wz
  case xy
  case xz
  case yz

# A vertex of the 24-cell: a choice of two nonzero axes and a sign on each.
form vertex
  case at
    link axes, like duo
    link sign-one, like sign
    link sign-two, like sign

# Flip a sign.
task flip-sign
  take s, like sign
  like sign
  fork case, read s
    case neg
      send back
        make pos
    case pos
      send back
        make neg

# The antipode of a vertex: the diametrically opposite point, both signs flipped, the other end of its line.
task antipode
  take v, like vertex
  like vertex
  fork case, read v
    case at
      link axes
      link sign-one
      link sign-two
      send back
        make at
          bind axes
            read axes
          bind sign-one
            call flip-sign
              read sign-one
          bind sign-two
            call flip-sign
              read sign-two

# A truth value, to test vertex equality.
form flag
  case yes
  case no

task same-sign
  take a, like sign
  take b, like sign
  like flag
  fork case, read a
    case neg
      fork case, read b
        case neg
          send back
            make yes
        case pos
          send back
            make no
    case pos
      fork case, read b
        case neg
          send back
            make no
        case pos
          send back
            make yes

task and-flag
  take a, like flag
  take b, like flag
  like flag
  fork case, read a
    case yes
      send back
        read b
    case no
      send back
        make no

# Two vertices are the same when their axis-pair and both signs agree. (Same axes assumed; the law acts within a line.)
task same-vertex
  take a, like vertex
  take b, like vertex
  like flag
  fork case, read a
    case at
      link axes-a
      link s1
      link s2
      fork case, read b
        case at
          link axes-b
          link t1
          link t2
          send back
            call and-flag
              call same-sign
                read s1
                read t1
              call same-sign
                read s2
                read t2

# The ANTIPODE is an INVOLUTION: antipode (antipode v) = v, for every vertex. The opposite of the opposite is the start.
rule antipode-is-an-involution
  mark v, like vertex
  show hold
    call is-equal
      call antipode
        call antipode
          read v
      read v
  fold v

# A sign and its flip always differ: same-sign s (flip-sign s) = no. The seed of the antipode having no fixed point.
rule flip-sign-differs
  mark s, like sign
  show hold
    call is-equal
      call same-sign
        read s
        call flip-sign
          read s
      make no
  fold s

# The antipode is FIXED-POINT-FREE: no vertex equals its own antipode, same-vertex v (antipode v) = no. Because the
# antipode flips both signs and a flipped sign always differs. This is what makes the twenty-four vertices pair into
# twelve genuine lines (antipodal pairs), with none its own partner.
rule antipode-has-no-fixed-point
  mark v, like vertex
  show hold
    call is-equal
      call same-vertex
        read v
        call antipode
          read v
      make no
  fold v

# COUNT: twenty-four vertices, six axis-pairs each with four sign choices, 6 * 4 = 24.
hold twenty-four-vertices-from-six-pairs-four-signs
  call is-equal
    code 24
    call multiply
      code 6
      code 4

# The twenty-four vertices pair into twelve antipodal lines: 24 = 2 * 12.
hold vertices-pair-into-twelve-lines
  call is-equal
    code 24
    call multiply
      code 2
      code 12

# SELF-DUALITY and Euler: the f-vector is (24, 96, 96, 24), vertices equal cells and edges equal faces, and the
# alternating sum vanishes as every convex 4-polytope's must: V - E + F - C = 24 - 96 + 96 - 24 = 0.
hold euler-characteristic-vanishes
  call is-equal
    code 0
    call subtract
      call add
        call subtract
          code 24
          code 96
        code 96
      code 24
