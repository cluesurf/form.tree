form glyph
  case o
  case i

form word
  case nil
  case cons
    link head, like glyph
    link tail, like word

form phase
  case even
  case odd

task step
  take s, like phase
  take g, like glyph
  like phase
  fork case, read g
    case o
      send back
        read s
    case i
      fork case, read s
        case even
          send back
            make odd
        case odd
          send back
            make even

task run
  take s, like phase
  take w, like word
  like phase
  fork case, read w
    case nil
      send back
        read s
    case cons
      link head
      link tail
      send back
        call run
          call step
            read s
            read head
          read tail

task append
  take u, like word
  take v, like word
  like word
  fork case, read u
    case nil
      send back
        read v
    case cons
      link head
      link tail
      send back
        make cons
          bind head
            read head
          bind tail
            call append
              read tail
              read v

rule run-cons-steps
  mark s, like phase
  mark g, like glyph
  mark w, like word
  show hold
    call is-equal
      call run
        read s
        make cons
          bind head
            read g
          bind tail
            read w
      call run
        call step
          read s
          read g
        read w
  calm

rule append-cons-steps
  mark g, like glyph
  mark u, like word
  mark v, like word
  show hold
    call is-equal
      call append
        make cons
          bind head
            read g
          bind tail
            read u
        read v
      make cons
        bind head
          read g
        bind tail
          call append
            read u
            read v
  calm

# TRUE: the homomorphism. Should PASS with generalized-IH (s changes along the recursion).
rule run-distributes-over-append
  mark s, like phase
  mark u, like word
  mark v, like word
  show hold
    call is-equal
      call run
        read s
        call append
          read u
          read v
      call run
        call run
          read s
          read u
        read v
  fold u
    cite run-cons-steps
    cite append-cons-steps
