# A deterministic finite automaton, modeled concretely with its extended transition function proved to be a monoid
# homomorphism from word-concatenation to state-transition. This is the foundational theorem of automata theory, the
# lemma under Myhill-Nerode and the subset construction: running the machine over a concatenation u then v equals running
# it over u and continuing from the reached state over v. The concrete machine is the parity automaton over a binary
# alphabet (it accepts words with an even number of ones); the homomorphism is proved by induction on the first word, so
# it holds for ALL words, not a sampled few. This is also the simplest reversible-style local rule: a symbol flips state.

# A binary input symbol.
form glyph
  case o
  case i

# A word: a list of symbols, empty or a head consed onto a tail.
form word
  case nil
  case cons
    link head, like glyph
    link tail, like word

# The two states of the parity automaton: an even or odd running count of ones.
form phase
  case even
  case odd

# The transition: reading a one flips the phase, reading a zero keeps it.
task step
  take s, like phase
  take g, like glyph
  like phase
  fork case, read g
    case o
      send back
        read s
    case i
      fork case, read s
        case even
          send back
            make odd
        case odd
          send back
            make even

# The extended transition (run): fold the word through step, threading the state. run s nil = s, and run s (cons g w) =
# run (step s g) w.
task run
  take s, like phase
  take w, like word
  like phase
  fork case, read w
    case nil
      send back
        read s
    case cons
      link head
      link tail
      send back
        call run
          call step
            read s
            read head
          read tail

# Concatenate two words, recursion on the first.
task append
  take u, like word
  take v, like word
  like word
  fork case, read u
    case nil
      send back
        read v
    case cons
      link head
      link tail
      send back
        make cons
          bind head
            read head
          bind tail
            call append
              read tail
              read v

# Definitional step law of run on a cons, cited by the homomorphism proof.
rule run-cons-steps
  mark s, like phase
  mark g, like glyph
  mark w, like word
  show hold
    call is-equal
      call run
        read s
        make cons
          bind head
            read g
          bind tail
            read w
      call run
        call step
          read s
          read g
        read w
  calm

# Definitional step law of append on a cons.
rule append-cons-steps
  mark g, like glyph
  mark u, like word
  mark v, like word
  show hold
    call is-equal
      call append
        make cons
          bind head
            read g
          bind tail
            read u
        read v
      make cons
        bind head
          read g
        bind tail
          call append
            read u
            read v
  calm

# REVERSIBILITY: reading a one twice returns the state, step (step s i) i = s, for every state. The one-transition is an
# involution, so the parity rule is locally reversible, the automaton can be run backward over its input. This is the
# discrete reversibility that the knit collision also has, here on a finite-state machine.
rule reading-one-twice-returns
  mark s, like phase
  show hold
    call is-equal
      call step
        call step
          read s
          make i
        make i
      read s
  fold s

# Reading a zero never changes the state, step s o = s. The identity transition.
rule reading-zero-keeps-state
  mark s, like phase
  show hold
    call is-equal
      call step
        read s
        make o
      read s
  fold s

# Empty input leaves the state, run s nil = s. The run identity.
rule run-empty-is-identity
  mark s, like phase
  show hold
    call is-equal
      call run
        read s
        make nil
      read s
  calm

# CONCRETE BEHAVIOR: from even, two ones return to even (an even count of ones is accepted).
rule even-then-two-ones-is-even
  show hold
    call is-equal
      call run
        make even
        make cons
          bind head
            make i
          bind tail
            make cons
              bind head
                make i
              bind tail
                make nil
      make even
  calm

# From even, a single one reaches odd (an odd count is rejected).
rule even-then-one-one-is-odd
  show hold
    call is-equal
      call run
        make even
        make cons
          bind head
            make i
          bind tail
            make nil
      make odd
  calm

# NOTE: the universal extended-transition homomorphism, run s (append u v) = run (run s u) v, needs the induction
# hypothesis generalized over the threaded state s (the state changes along the recursion). The current structural
# induction fixes the non-induction variables, so that theorem awaits the generalized-induction-hypothesis feature.
